# Bloqueia acesso direto às chaves, às funções internas e aos arquivos antigos da Vercel (.js).
<FilesMatch "^(config|_lib)\.php$|\.js$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
